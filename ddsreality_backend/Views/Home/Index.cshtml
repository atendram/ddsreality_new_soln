@model PublicPage
@{var banners=Model.Items.Where(x=>x.Kind=="Banner").ToList();var hero=banners.FirstOrDefault();var projects=Model.Items.Where(x=>x.Kind=="Project").ToList();}
<section class="hero"><div class="hero-copy"><span class="eyebrow">@(Model.Settings.SiteId=="realty"?"DDS REALTY · MUMBAI":"DISTINCT DIGITAL SOLUTION")</span><h1>@(hero?.Title ?? Model.Settings.Tagline)</h1><p>@(hero?.Subtitle ?? "Thoughtful guidance. Clear choices. A team that understands your goals.")</p><div class="hero-actions"><a class="button gold" href="@(string.IsNullOrEmpty(hero?.LinkUrl)?Model.Root+"/projects":hero.LinkUrl)">@(hero?.ButtonText ?? "Explore projects") ↗</a><a href="@(Model.Root+"/contact")">Talk to our team →</a></div><div class="hero-note"><span>01 /</span> Personal guidance, from your first question.</div></div><div class="hero-image">@if(!string.IsNullOrEmpty(hero?.ImagePath)){<img src="@hero.ImagePath" alt="@hero.AltText" fetchpriority="high" width="1200" height="900"/>}<div class="image-caption">A new perspective.<br/><strong>A place to call your own.</strong></div></div></section>
<div class="trust-strip"><span>Local expertise</span><span>Thoughtful shortlisting</span><span>Clear communication</span><span>Personal support</span></div>
@if(banners.Count>1){<section class="container promo-grid">@foreach(var banner in banners.Skip(1)){<article class="promo">@if(banner.ImagePath!=""){<img src="@banner.ImagePath" alt="@banner.AltText" loading="lazy" width="600" height="350"/>}<div><h2>@banner.Title</h2><p>@banner.Subtitle</p>@if(banner.LinkUrl!=""){<a href="@banner.LinkUrl">@banner.ButtonText →</a>}</div></article>}</section>}
<section class="container section" id="projects"><div class="section-heading"><div><span class="eyebrow">SPACES WITH POSSIBILITY</span><h2>Find your next chapter.</h2><p>A considered collection of projects. Explore what feels right for you.</p></div><a class="text-link" href="@(Model.Root+"/projects")">View all projects ↗</a></div><div class="cards">@foreach(var item in projects){<partial name="_Card" model="item"/>}</div>@if(projects.Count==0){<div class="empty">Our project collection is being updated. <a href="@(Model.Root+"/contact")">Contact us for current availability →</a></div>}</section>
<section class="about-band"><div class="container about-grid"><div class="about-photo">@if(Model.Settings.AboutImage!=""){<img src="@Model.Settings.AboutImage" alt="@Model.Settings.AboutTitle" loading="lazy" width="700" height="600"/>}</div><div><span class="eyebrow">PEOPLE BEFORE PROPERTY</span><h2>@Model.Settings.AboutTitle</h2><p class="prose">@(Model.Settings.AboutBody.Length>450?Model.Settings.AboutBody[..450]+"…":Model.Settings.AboutBody)</p><a class="button" href="@(Model.Root+"/about")">Get to know us ↗</a></div></div></section>
@{var services=Model.Items.Where(x=>x.Kind=="Service").ToList();}
@if(services.Count>0){<section class="container section"><span class="eyebrow">HOW WE HELP</span><h2>Support at every step.</h2><div class="cards">@foreach(var item in services){<article class="service-card"><h3>@item.Title</h3><p>@item.Subtitle</p><p class="prose">@item.Body</p>@if(item.LinkUrl!=""){<a href="@item.LinkUrl">@item.ButtonText →</a>}</article>}</div></section>}
<partial name="_People" model="Model"/>
@{var blogs=Model.Items.Where(x=>x.Kind=="Blog").ToList();}
@if(blogs.Count>0){<section class="container section"><div class="section-heading"><div><span class="eyebrow">THE DDS JOURNAL</span><h2>A little more clarity.</h2></div><a href="@(Model.Root+"/blog")">All insights ↗</a></div><div class="cards">@foreach(var item in blogs){<partial name="_Card" model="item"/>}</div></section>}
