@model PasswordModel
<h1>Change password</h1><p>This signs you out on all devices.</p><form method="post"><div asp-validation-summary="All" class="validation"></div><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" autocomplete="current-password"/><label asp-for="NewPassword">New password · at least 12 characters</label><input asp-for="NewPassword" autocomplete="new-password"/><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" autocomplete="new-password"/><button class="button wide">Save new password</button></form><a href="/admin">← Back to dashboard</a>
