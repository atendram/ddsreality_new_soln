@model List<Enquiry>
@{ViewData["Title"]="Enquiries";string site=ViewBag.Site;int page=ViewBag.Page;int total=ViewBag.Total;}
<div class="page-heading"><div><span class="eyebrow">YOUR CONVERSATIONS</span><h1>Enquiry inbox</h1><p class="muted">@total enquiries · Follow up and keep your team informed.</p></div></div>
@if(Model.Count==0){<section class="panel empty">No enquiries yet. Website form submissions will appear here.</section>}
@foreach(var item in Model){<article class="panel enquiry"><div class="section-head"><div><h2>@item.Name</h2><p>@item.ProjectTitle · @item.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</p></div><span class="badge">@item.Status</span></div><div class="actions"><a href="tel:@item.Phone">@item.Phone</a>@if(!string.IsNullOrEmpty(item.Email)){<a href="mailto:@item.Email">@item.Email</a>}</div><p class="prose">@item.Message</p><form method="post" action="/admin/enquiries/update">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@item.Version"/><label for="status-@item.Id">Status</label><select name="status" id="status-@item.Id">@foreach(var status in new[]{"New","Contacted","Site visit","Closed"}){<option selected="@(item.Status==status)">@status</option>}</select><label for="notes-@item.Id">Internal notes</label><textarea name="notes" id="notes-@item.Id" rows="2" maxlength="3000">@item.Notes</textarea><button class="secondary">Save follow-up</button></form><form method="post" action="/admin/enquiries/delete" data-confirm="Permanently delete this enquiry and its personal details?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@item.Version"/><button class="danger-link">Delete enquiry</button></form></article>}
<nav class="pagination" aria-label="Enquiry pages">@if(page>1){<a href="/admin/enquiries?site=@site&page=@(page-1)">← Previous</a>}<span>Page @(page)</span>@if(page*20<total){<a href="/admin/enquiries?site=@site&page=@(page+1)">Next →</a>}</nav>
