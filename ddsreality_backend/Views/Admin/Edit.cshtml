@model ContentEntry
@{ViewData["Title"]=Model.Id==0?"New "+Model.Kind:Model.Title;}
<a class="back" href="/admin/content?site=@Model.SiteId&kind=@Model.Kind">← Back to @Model.Kind.ToLowerInvariant() content</a><div class="page-heading"><div><span class="eyebrow">@Model.Kind EDITOR</span><h1>@(Model.Id==0?"Create something new.":"Make every detail count.")</h1></div><span class="badge @(Model.Published?"live":"")">@(Model.Published?"Published":"Draft")</span></div>
<form method="post" enctype="multipart/form-data" class="editor" data-dirty>
<div asp-validation-summary="All" class="validation full"></div><input asp-for="Id" type="hidden"/><input asp-for="SiteId" type="hidden"/><input asp-for="Kind" type="hidden"/><input asp-for="Version" type="hidden"/>
<div class="editor-main"><section class="panel"><h2>Content details</h2><label asp-for="Title">@(Model.Kind=="Team"?"Full name":Model.Kind=="Testimonial"?"Customer name":"Title")</label><input asp-for="Title" required maxlength="160"/><label asp-for="Slug">URL slug / internal identifier</label><input asp-for="Slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="160"/><small>Lowercase words separated by hyphens. Keep existing project and blog slugs to preserve links.</small><label asp-for="Subtitle">@(Model.Kind=="Team"?"Role / designation":Model.Kind=="Testimonial"?"Customer context":"Subtitle / short description")</label><input asp-for="Subtitle" maxlength="300"/><label asp-for="Body">@(Model.Kind=="Testimonial"?"Customer testimonial":"Description / article / biography")</label><textarea asp-for="Body" rows="9" maxlength="30000"></textarea><small>Plain text. Paragraphs are preserved; HTML and scripts are displayed as text.</small></section>
@if(Model.Kind=="Project"){
<section class="panel"><h2>Property information</h2><div class="form-grid"><div><label asp-for="Price">Price display</label><input asp-for="Price" placeholder="e.g. ₹1.25 Cr onwards" maxlength="100"/></div><div><label asp-for="Configuration">Configuration / carpet area</label><input asp-for="Configuration" placeholder="e.g. 2 & 3 BHK · 700–1,000 sq ft" maxlength="100"/></div><div><label asp-for="PropertyType">Property type</label><input asp-for="PropertyType" maxlength="100"/></div><div><label asp-for="Possession">Possession / project status</label><input asp-for="Possession" maxlength="100"/></div><div><label asp-for="Location">Location / address</label><input asp-for="Location" maxlength="300"/></div><div><label asp-for="ReraNumber">RERA number</label><input asp-for="ReraNumber" maxlength="100"/></div></div><label asp-for="Highlights">Highlights · one per line</label><textarea asp-for="Highlights" rows="5" maxlength="8000"></textarea><label asp-for="Amenities">Amenities · one per line</label><textarea asp-for="Amenities" rows="5" maxlength="8000"></textarea><label asp-for="MapUrl">Google Maps embed URL</label><textarea asp-for="MapUrl" rows="3" maxlength="5000" placeholder="https://www.google.com/maps/embed?pb=..."></textarea><small>Google Maps → Share → Embed a map → copy only the URL inside src="…". Verify this is the project location.</small></section>
}
@if(Model.Kind is "Banner" or "Reel" or "Service"){
<section class="panel"><h2>@(Model.Kind=="Reel"?"Reel video link":"Call to action")</h2><label asp-for="LinkUrl">Destination URL</label><input asp-for="LinkUrl" placeholder="https://… or /projects" maxlength="500"/><label asp-for="ButtonText">Button label</label><input asp-for="ButtonText" maxlength="50"/><small>Footer reels use poster images and open the video link on click, keeping page loads light.</small></section>
}
</div><aside class="editor-side"><section class="panel"><h2>Publishing</h2>@if(Model.Id!=0 && (Model.Kind=="Project" || Model.Kind=="Blog")){<a href="/admin/preview/@Model.Id" target="_blank" rel="noopener">Preview saved content ↗</a>}<label class="check"><input asp-for="Published"/> Publish on website</label><label class="check"><input asp-for="Featured"/> Featured on homepage</label><label asp-for="SortOrder">Display order</label><input asp-for="SortOrder" min="0" max="99999"/><small>Smaller numbers appear first. Featured items appear before other items on the homepage.</small><button class="button wide">Save changes</button><p class="small">Published content updates immediately after saving.</p></section><section class="panel"><h2>@(Model.Kind=="Banner"?"Banner image":Model.Kind=="Reel"?"Video poster":"Cover image")</h2>@if(Model.ImagePath!=""){<img class="image-preview" src="@Model.ImagePath" alt="Current image"/>}<label for="imageFile">Upload image</label><input type="file" name="imageFile" id="imageFile" accept="image/png,image/jpeg,image/webp"/><small>JPG, PNG or WebP · up to 5 MB. WebP recommended. Banner: 1,920 × 1,080; cards: 1,200 × 800.</small><label asp-for="ImagePath">Existing image path</label><input asp-for="ImagePath" maxlength="500"/><label asp-for="AltText">Image description (accessibility)</label><input asp-for="AltText" maxlength="200"/></section><section class="panel"><h2>Search appearance</h2><label asp-for="MetaDescription">Meta description</label><textarea asp-for="MetaDescription" rows="4" maxlength="160"></textarea><small>Up to 160 characters.</small></section></aside></form>
@if(Model.Kind=="Project" && Model.Id!=0){
<section class="panel"><h2>Gallery & floor plans</h2><p class="muted">Save the main form before managing these images. Caption describes the image or floor plan.</p><div class="media-grid">@foreach(var item in Model.Media.OrderBy(x=>x.SortOrder).ThenBy(x=>x.Id)){<article><a href="@item.ImagePath" target="_blank" rel="noopener"><img src="@item.ImagePath" alt="@item.Caption" loading="lazy"/></a><strong>@item.Caption</strong><small>@item.Kind · order @item.SortOrder</small><form method="post" action="/admin/media/delete" data-confirm="Remove this image from the project?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@Model.Version"/><button class="danger-link">Remove</button></form></article>}</div>
<form method="post" action="/admin/media" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" name="EntryId" value="@Model.Id"/><input type="hidden" name="Version" value="@Model.Version"/><div class="form-grid"><div><label for="mediaCaption">Caption</label><input id="mediaCaption" name="Caption" required maxlength="160"/></div><div><label for="mediaKind">Image type</label><select id="mediaKind" name="Kind"><option>Gallery</option><option>FloorPlan</option></select></div><div><label for="mediaFile">Image file</label><input id="mediaFile" type="file" name="imageFile" required accept="image/png,image/jpeg,image/webp"/></div><div><label for="mediaOrder">Order</label><input id="mediaOrder" name="SortOrder" type="number" value="0" min="0" max="99999"/></div></div><button class="secondary">Add image</button></form></section>
}
