@model SiteSettings
@{ViewData["Title"]="Website settings";}
<div class="page-heading"><div><span class="eyebrow">BRAND & WEBSITE</span><h1>A website that feels like you.</h1><p class="muted">Manage your identity, company information and contact details.</p></div></div>
<form method="post" enctype="multipart/form-data" data-dirty><input asp-for="SiteId" type="hidden"/><input asp-for="Version" type="hidden"/><div asp-validation-summary="All" class="validation"></div>
<section class="panel"><h2>Brand identity</h2><div class="form-grid"><div><label asp-for="Name">Website name</label><input asp-for="Name"/></div><div><label asp-for="Tagline">Tagline</label><input asp-for="Tagline"/></div><div><label asp-for="LogoPath">Existing logo path</label><input asp-for="LogoPath"/></div><div><label asp-for="PrimaryColor">Primary colour (#RRGGBB)</label><input asp-for="PrimaryColor"/></div><div><label asp-for="AccentColor">Accent colour (#RRGGBB)</label><input asp-for="AccentColor"/></div><div><label asp-for="MetaDescription">Default meta description</label><input asp-for="MetaDescription"/></div></div><label for="logoFile">Upload logo · PNG / WebP / JPG, max 5 MB</label><input id="logoFile" type="file" name="logoFile" accept="image/png,image/jpeg,image/webp"/></section><section class="panel"><h2>About your company</h2><div class="form-grid"><div><label asp-for="AboutTitle">About us heading</label><input asp-for="AboutTitle"/></div><div><label asp-for="AboutBody">About us details</label><textarea asp-for="AboutBody" rows="7"></textarea></div><div><label asp-for="AboutImage">Existing about image path</label><input asp-for="AboutImage"/></div></div><label for="aboutFile">Upload about image · PNG / WebP / JPG, max 5 MB</label><input id="aboutFile" type="file" name="aboutFile" accept="image/png,image/jpeg,image/webp"/></section><section class="panel"><h2>Contact & social links</h2><div class="form-grid"><div><label asp-for="Phone">Phone</label><input asp-for="Phone"/></div><div><label asp-for="Email">Email</label><input asp-for="Email"/></div><div><label asp-for="WhatsApp">WhatsApp digits with country code</label><input asp-for="WhatsApp"/></div><div><label asp-for="Address">Office address</label><textarea asp-for="Address" rows="7"></textarea></div><div><label asp-for="Facebook">Facebook link</label><input asp-for="Facebook"/></div><div><label asp-for="Instagram">Instagram link</label><input asp-for="Instagram"/></div><div><label asp-for="YouTube">YouTube link</label><input asp-for="YouTube"/></div><div><label asp-for="FooterText">Footer description</label><input asp-for="FooterText"/></div></div></section><section class="panel"><h2>Privacy information</h2><div class="form-grid"><div><label asp-for="PrivacyText">Privacy text shown alongside the enquiry form</label><textarea asp-for="PrivacyText" rows="7"></textarea></div></div></section><section class="panel"><h2>Homepage sections & motion</h2><label class="check"><input asp-for="ShowTeam"/>Show team section</label><label class="check"><input asp-for="ShowTestimonials"/>Show testimonials</label><label class="check"><input asp-for="ShowReels"/>Show footer reels</label><label class="check"><input asp-for="EnableAnimations"/>Enable subtle animations</label><p class="small muted">Sections stay hidden until you publish content. Reduced-motion preferences are always respected.</p></section><button class="button">Save website settings</button></form>