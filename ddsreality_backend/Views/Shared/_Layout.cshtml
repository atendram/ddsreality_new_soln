@{var settings=ViewBag.Settings as SiteSettings ?? new SiteSettings();var root=Catalog.Root(settings.SiteId);var reels=ViewBag.Reels as List<ContentEntry> ?? [];var page=Model as PublicPage;var description=page?.Entry?.MetaDescription; if(string.IsNullOrWhiteSpace(description))description=settings.MetaDescription;}
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@(string.IsNullOrEmpty(page?.Title)?settings.Name:page.Title+" | "+settings.Name)</title><meta name="description" content="@description"/><link rel="icon" href="~/images/favicon_new.webp"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><script src="~/js/site.js" asp-append-version="true" defer></script></head>
<body class="@(settings.EnableAnimations?"motion":"")" style="--primary:@settings.PrimaryColor;--accent:@settings.AccentColor"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="@(root+"/")">@if(settings.LogoPath!=""){<img src="@settings.LogoPath" width="143" height="100" alt="@settings.Name"/>}else{<strong>@settings.Name</strong>}</a><button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu</button><nav id="main-nav" aria-label="Main navigation"><a href="@(root+"/projects")">Projects</a><a href="@(root+"/about")">About us</a><a href="@(root+"/blog")">Insights</a><a href="@(root+"/contact")">Contact</a><a class="admin-link" href="/account/login">@(User.Identity?.IsAuthenticated==true?"Admin panel":"Admin sign in")</a><a class="button" href="@(root+"/contact")">Let's connect ↗</a></nav></header>
<main id="main"><partial name="_Alerts"/>@RenderBody()</main>
<footer class="site-footer"><div class="footer-top"><div><span class="eyebrow">@settings.Name</span><h2>Good decisions start<br/>with a conversation.</h2><a class="button gold" href="@(root+"/contact")">Speak with our team ↗</a></div><div><h3>Visit or call</h3><p>@settings.Address</p>@if(settings.Phone!=""){<a href="tel:@settings.Phone">@settings.Phone</a>}@if(!string.IsNullOrEmpty(settings.Email)){<a href="mailto:@settings.Email">@settings.Email</a>}<p>@settings.FooterText</p></div><div><h3>Stay connected</h3>@if(settings.Instagram!=""){<a href="@settings.Instagram" target="_blank" rel="noopener">Instagram ↗</a>}@if(settings.Facebook!=""){<a href="@settings.Facebook" target="_blank" rel="noopener">Facebook ↗</a>}@if(settings.YouTube!=""){<a href="@settings.YouTube" target="_blank" rel="noopener">YouTube ↗</a>}<a href="/account/login">Admin sign in</a></div></div>
@if(settings.ShowReels && reels.Count>0){<div class="reels"><h3>From our feed</h3><div class="reel-grid">@foreach(var reel in reels){<a href="@reel.LinkUrl" target="_blank" rel="noopener">@if(reel.ImagePath!=""){<img src="@reel.ImagePath" alt="@reel.AltText" width="180" height="240" loading="lazy"/>}<span>▶ @reel.Title</span></a>}</div></div>}
<div class="footer-bottom"><span>© @DateTime.UtcNow.Year @settings.Name</span><a href="@(root+"/privacy")">Privacy</a><span>Property details and availability are subject to confirmation.</span></div></footer>
@if(settings.WhatsApp!=""){<a class="whatsapp" href="https://wa.me/@settings.WhatsApp" target="_blank" rel="noopener" aria-label="Contact us on WhatsApp">WhatsApp ↗</a>}
</body></html>
