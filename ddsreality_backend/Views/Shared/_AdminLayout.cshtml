@{string site=ViewBag.Site ?? "realty";}
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>@ViewData["Title"] · DDS Studio</title><link rel="stylesheet" href="~/css/cms.css" asp-append-version="true"/><script src="~/js/cms.js" asp-append-version="true" defer></script></head>
<body class="admin"><a class="skip" href="#main">Skip to content</a><aside class="sidebar"><a class="studio" href="/admin?site=@site"><span class="brand-square">D.</span><span>DDS <b>Studio</b><small>CONTENT MANAGEMENT</small></span></a>
<form method="get" action="/admin" class="site-picker"><label for="site">YOUR WEBSITE</label><select id="site" name="site"><option value="realty" selected="@(site=="realty")">DDS Realty</option><option value="dds" selected="@(site=="dds")">DDS Digital</option></select><button class="subtle" type="submit">Switch website →</button></form>
<nav aria-label="Admin"><a href="/admin?site=@site">Overview</a><span class="nav-label">WEBSITE CONTENT</span>@foreach(var kind in Catalog.Kinds){<a href="/admin/content?site=@site&kind=@kind">@(kind=="Project"?"Projects":kind=="Banner"?"Banners":kind=="Blog"?"Blog posts":kind=="Team"?"Team members":kind=="Testimonial"?"Testimonials":kind=="Reel"?"Footer reels":"Services")</a>}<span class="nav-label">BUSINESS</span><a href="/admin/enquiries?site=@site">Enquiries</a><a href="/admin/settings?site=@site">Brand & website settings</a><a href="/admin/audit">Activity log</a><a href="/account/password">Change password</a></nav><div class="sidebar-foot">Your website, in your control.<small>Draft → Review → Publish</small></div></aside>
<div class="admin-body"><header class="admin-top"><span>@Catalog.Label(site) <span class="muted">/ Workspace</span></span><div class="actions"><a href="@(Catalog.Root(site)+"/")" target="_blank" rel="noopener">View website ↗</a><form method="post" action="/account/logout">@Html.AntiForgeryToken()<button class="subtle">Sign out</button></form></div></header><main id="main" class="admin-main"><partial name="_Alerts"/>@RenderBody()</main><footer class="admin-footer">DDS Studio · Changes go live when published.</footer></div>
<partial name="_Confirm"/>
</body></html>
