@model List<AuditEvent>
@{ViewData["Title"]="Activity log";int page=ViewBag.Page;int total=ViewBag.Total;}
<span class="eyebrow">ACCOUNTABILITY</span><h1>Activity log</h1><p class="muted">Content, settings, enquiry and credential changes across both websites.</p><div class="panel table-wrap"><table><thead><tr><th>When (UTC)</th><th>Administrator</th><th>Action</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CreatedUtc.ToString("dd MMM yyyy HH:mm")</td><td>@item.Actor</td><td>@item.Action</td></tr>}</tbody></table></div><nav class="pagination">@if(page>1){<a href="/admin/audit?page=@(page-1)">← Previous</a>}<span>Page @(page)</span>@if(page*50<total){<a href="/admin/audit?page=@(page+1)">Next →</a>}</nav>
