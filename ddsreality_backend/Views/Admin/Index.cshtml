@model Dashboard
@{ViewData["Title"]="Overview";string site=ViewBag.Site;}
<div class="page-heading"><div><span class="eyebrow">YOUR DIGITAL FRONT DOOR</span><h1>Welcome to your workspace.</h1><p class="muted">Keep your website fresh. Turn interest into conversations.</p></div><a class="button" href="/admin/edit?site=@site&kind=Project">+ Add a project</a></div>
<div class="stats"><article><span>Projects</span><strong>@Model.Projects</strong><small>Your property collection</small></article><article><span>Published content</span><strong>@Model.Published</strong><small>Visible on your website</small></article><article><span>Drafts</span><strong>@Model.Drafts</strong><small>Ready for your review</small></article><article class="accent-card"><span>New enquiries</span><strong>@Model.NewEnquiries</strong><a href="/admin/enquiries?site=@site">Open inbox →</a></article></div>
<div class="dashboard-grid"><section class="panel"><div class="section-head"><h2>Recently updated</h2><a href="/admin/content?site=@site">All projects →</a></div>@if(Model.Recent.Count==0){<div class="empty">Start with your first project or banner.</div>}@foreach(var entry in Model.Recent){<a class="recent-row" href="/admin/edit?id=@entry.Id"><span class="row-icon">@entry.Kind[..1]</span><span><strong>@entry.Title</strong><small>@entry.Kind · @entry.UpdatedUtc.ToString("dd MMM yyyy") UTC</small></span><span class="badge @(entry.Published?"live":"")">@(entry.Published?"Published":"Draft")</span><span>↗</span></a>}</section><aside class="panel dark-panel"><span class="eyebrow">MAKE IT YOURS</span><h2>A consistent brand.<br/>Everywhere.</h2><p>Update your logo, colours, company story and contact details from one place.</p><a class="button gold" href="/admin/settings?site=@site">Open website settings →</a><hr/><h3>A simple publishing flow</h3><p>01 &nbsp; Add your content<br/>02 &nbsp; Save as a draft<br/>03 &nbsp; Verify details and publish</p></aside></div>
