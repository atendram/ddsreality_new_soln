@model PublicPage
@{string kind=ViewBag.Kind;var route=Model.Root+(kind=="Project"?"/projects":"/blog");}
<section class="page-banner"><div class="container"><span class="eyebrow">@Model.Settings.Name</span><h1>@Model.Title</h1><p>Explore, compare and start a conversation.</p></div></section><section class="container section"><form method="get" class="search"><label class="sr-only" for="q">Search</label><input id="q" name="q" value="@Model.Query" maxlength="160" placeholder="@(kind=="Project"?"Search by project or location":"Search articles")"/><button class="button">Search →</button></form><p class="muted">@Model.Total results</p><div class="cards">@foreach(var item in Model.Items){<partial name="_Card" model="item"/>}</div>@if(Model.Total==0){<div class="empty">No results found. Try another search or <a href="@(Model.Root+"/contact")">contact our team</a>.</div>}<nav class="pagination" aria-label="Result pages">@if(Model.Page>1){<a href="@route?q=@Uri.EscapeDataString(Model.Query)&page=@(Model.Page-1)">← Previous</a>}<span>Page @Model.Page</span>@if(Model.Page*12<Model.Total){<a href="@route?q=@Uri.EscapeDataString(Model.Query)&page=@(Model.Page+1)">Next →</a>}</nav></section>
