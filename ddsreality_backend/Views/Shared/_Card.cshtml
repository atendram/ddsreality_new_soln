@model ContentEntry
@{var url=Catalog.Root(Model.SiteId)+(Model.Kind=="Blog"?"/blog/":"/projects/")+Model.Slug;}
<article class="property-card"><a class="card-image" href="@url">@if(Model.ImagePath!=""){<img src="@Model.ImagePath" alt="@(string.IsNullOrEmpty(Model.AltText)?Model.Title:Model.AltText)" width="600" height="420" loading="lazy"/>}else{<span class="image-placeholder">DDS</span>}@if(Model.Featured){<span class="card-badge">Featured</span>}</a><div class="card-content"><span class="eyebrow">@(Model.Kind=="Blog"?"INSIGHTS":Model.Location)</span><h3><a href="@url">@Model.Title</a></h3><p>@(Model.Kind=="Blog"?Model.Subtitle:Model.Configuration)</p><div class="card-bottom"><strong>@(Model.Kind=="Blog"?"Read the story":string.IsNullOrEmpty(Model.Price)?"Enquire for price":Model.Price)</strong><a href="@url" aria-label="View @Model.Title">↗</a></div></div></article>
