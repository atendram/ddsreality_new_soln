@if(TempData["Success"] is string success){<div class="notice success" role="status">@success <button type="button" data-dismiss aria-label="Dismiss notification">×</button></div>}
@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error <button type="button" data-dismiss aria-label="Dismiss notification">×</button></div>}
