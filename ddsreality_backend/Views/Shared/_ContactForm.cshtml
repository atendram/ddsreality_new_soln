@model PublicPage
<form method="post" action="@(Model.Root+"/contact")">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><input asp-for="Contact.ProjectId" type="hidden"/><div class="honeypot" aria-hidden="true"><label asp-for="Contact.Website">Website</label><input asp-for="Contact.Website" tabindex="-1" autocomplete="off"/></div><label asp-for="Contact.Name">Your name</label><input asp-for="Contact.Name" required maxlength="100" autocomplete="name"/><label asp-for="Contact.Phone">Phone number</label><input asp-for="Contact.Phone" type="tel" required maxlength="30" autocomplete="tel"/><label asp-for="Contact.Email">Email · optional</label><input asp-for="Contact.Email" type="email" maxlength="120" autocomplete="email"/><label asp-for="Contact.Message">How can we help?</label><textarea asp-for="Contact.Message" rows="4" maxlength="2000" required></textarea><label class="check"><input asp-for="Contact.Consent" required/><span>I agree to be contacted about this enquiry and have read the <a href="@(Model.Root+"/privacy")">privacy information</a>.</span></label><button class="button wide">Send enquiry ↗</button></form>
