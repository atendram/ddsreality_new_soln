@model AdminList
@{ViewData["Title"]=Model.Kind;}
<div class="page-heading"><div><span class="eyebrow">WEBSITE CONTENT</span><h1>@Model.Kind management</h1><p class="muted">@Model.Total items · Control content, order and visibility.</p></div><a class="button" href="/admin/edit?site=@Model.Site&kind=@Model.Kind">+ Add @Model.Kind.ToLowerInvariant()</a></div>
<form method="get" class="search-bar"><input type="hidden" name="site" value="@Model.Site"/><input type="hidden" name="kind" value="@Model.Kind"/><label class="sr-only" for="q">Search title</label><input id="q" name="q" value="@Model.Query" placeholder="Search by title…" maxlength="160"/><button class="secondary">Search</button></form>
<div class="panel table-wrap"><table><thead><tr><th>Content</th><th>Order</th><th>Status</th><th>Last updated</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><a class="table-title" href="/admin/edit?id=@item.Id">@if(item.ImagePath!=""){<img src="@item.ImagePath" alt="" loading="lazy"/>}<span><strong>@item.Title</strong><small>/@item.Slug</small></span></a></td><td>@item.SortOrder</td><td><span class="badge @(item.Published?"live":"")">@(item.Published?"Published":"Draft")</span></td><td>@item.UpdatedUtc.ToString("dd MMM yyyy")</td><td><div class="actions"><a href="/admin/edit?id=@item.Id">Edit</a><form method="post" action="/admin/publish" data-confirm="@(item.Published?"Hide this content from the website?":"Publish this content on the website?")">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@item.Version"/><button class="subtle">@(item.Published?"Unpublish":"Publish")</button></form><form method="post" action="/admin/delete" data-confirm="Permanently delete this content and its gallery references? This cannot be undone.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@item.Version"/><button class="danger-link">Delete</button></form></div></td></tr>}</tbody></table>@if(Model.Total==0){<div class="empty">No content yet. Add your first @Model.Kind.ToLowerInvariant().</div>}</div>
<nav class="pagination" aria-label="Content pages">@if(Model.Page>1){<a href="@Url.Action("Content",new{site=Model.Site,kind=Model.Kind,q=Model.Query,page=Model.Page-1})">← Previous</a>}<span>Page @Model.Page</span>@if(Model.Page*20<Model.Total){<a href="@Url.Action("Content",new{site=Model.Site,kind=Model.Kind,q=Model.Query,page=Model.Page+1})">Next →</a>}</nav>
