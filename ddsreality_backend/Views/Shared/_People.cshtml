@model PublicPage
@{var team=Model.Items.Where(x=>x.Kind=="Team").ToList();var reviews=Model.Items.Where(x=>x.Kind=="Testimonial").ToList();}
@if(Model.Settings.ShowTeam && team.Count>0){<section class="container section"><span class="eyebrow">MEET THE PEOPLE</span><h2>On your side, every step.</h2><div class="cards">@foreach(var item in team){<article class="person">@if(item.ImagePath!=""){<img src="@item.ImagePath" alt="@item.Title" width="400" height="450" loading="lazy"/>}<h3>@item.Title</h3><span class="eyebrow">@item.Subtitle</span><p class="prose">@item.Body</p></article>}</div></section>}
@if(Model.Settings.ShowTestimonials && reviews.Count>0){<section class="reviews-band"><div class="container section"><span class="eyebrow">IN THEIR WORDS</span><h2>Real people. Shared experiences.</h2><div class="cards">@foreach(var item in reviews){<figure class="quote"><span aria-hidden="true">“</span><blockquote>@item.Body</blockquote><figcaption><strong>@item.Title</strong><small>@item.Subtitle</small></figcaption></figure>}</div></div></section>}
